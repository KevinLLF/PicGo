#!/bin/bash
#
# VOC私域数据 ES→Kafka 同步程序 — 管理脚本
#
# 用法:
#   ./es-syncer.sh start                         启动定时守护进程（后台运行）
#   ./es-syncer.sh stop                          停止守护进程
#   ./es-syncer.sh status                        查看运行状态
#   ./es-syncer.sh restart                       重启守护进程
#   ./es-syncer.sh logs                          实时查看日志
#
#   ./es-syncer.sh backfill 2026-05-15           补单天数据（后台运行，完成后自动退出）
#   ./es-syncer.sh test 2026-05-15               测试模式（后台运行，只输出前20条到日志）
#   ./es-syncer.sh range 2026-05-10 2026-05-15   补时间段数据（后台运行，完成后自动退出）
#

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
JAR_FILE="$SCRIPT_DIR/vocPrivateDataMysqlKafkaSyncer.jar"
PID_FILE="$SCRIPT_DIR/es-syncer.pid"
LOG_DIR="$SCRIPT_DIR/logs"
MAIN_CLASS="com.voc.syncer.EsMain"

# 确保 logs 目录存在
mkdir -p "$LOG_DIR"

# 检查程序是否运行
is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        else
            rm -f "$PID_FILE"
        fi
    fi
    return 1
}

# 校验日期格式
validate_date() {
    if [[ ! "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        echo "错误: 日期格式不正确，请使用 yyyy-MM-dd 格式，例如 2026-05-15"
        return 1
    fi
    return 0
}

# 前置检查
check_jar() {
    if [ ! -f "$JAR_FILE" ]; then
        echo "[$(date '+%F %T')] 错误: 找不到 $JAR_FILE"
        return 1
    fi
    return 0
}

# ==================== 守护进程管理 ====================

start() {
    if is_running; then
        echo "[$(date '+%F %T')] ES同步程序已在运行 (PID: $(cat $PID_FILE))"
        return 1
    fi
    if ! check_jar; then return 1; fi

    echo -n "[$(date '+%F %T')] 正在启动ES同步程序..."
    nohup java -cp "$JAR_FILE" "$MAIN_CLASS" >> "$LOG_DIR/es-sync-console.log" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
        echo " 完成 (PID: $pid)"
        echo "  日志文件: $LOG_DIR/es-sync.log"
        echo "  控制台输出: $LOG_DIR/es-sync-console.log"
    else
        echo " 失败，请检查 $LOG_DIR/es-sync-console.log"
        rm -f "$PID_FILE"
        return 1
    fi
}

stop() {
    if ! is_running; then
        echo "[$(date '+%F %T')] ES同步程序未运行"
        rm -f "$PID_FILE"
        return 0
    fi

    local pid=$(cat "$PID_FILE")
    echo -n "[$(date '+%F %T')] 正在停止ES同步程序 (PID: $pid)..."
    kill "$pid"

    local waited=0
    while kill -0 "$pid" 2>/dev/null && [ $waited -lt 30 ]; do
        sleep 1
        waited=$((waited + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
        echo " 超时，强制终止"
        kill -9 "$pid"
    else
        echo " 已停止"
    fi
    rm -f "$PID_FILE"
}

status() {
    if is_running; then
        local pid=$(cat "$PID_FILE")
        echo "[$(date '+%F %T')] ES同步程序运行中 (PID: $pid)"
        ps -p "$pid" -o pid,etime,cmd --no-headers 2>/dev/null || true
    else
        echo "[$(date '+%F %T')] ES同步程序未运行"
    fi
}

logs() {
    if [ -f "$LOG_DIR/es-sync.log" ]; then
        tail -f "$LOG_DIR/es-sync.log"
    else
        echo "日志文件不存在: $LOG_DIR/es-sync.log"
    fi
}

# ==================== 手动补数据 ====================

# 补单天数据（后台运行，完成后自动退出）
backfill() {
    if ! check_jar; then return 1; fi
    local date="$1"
    if ! validate_date "$date"; then return 1; fi

    local log_file="$LOG_DIR/es-sync-backfill-${date}.log"
    echo "[$(date '+%F %T')] ES补数据已提交到后台运行"
    echo "  输入日期: $date（实际查询前一天）"
    echo "  日志文件: $log_file"
    nohup java -cp "$JAR_FILE" "$MAIN_CLASS" --date "$date" > /dev/null 2>&1 &
    echo "  PID: $!"
}

# 测试模式（后台运行，完成后自动退出）
test_mode() {
    if ! check_jar; then return 1; fi
    local date="$1"
    if ! validate_date "$date"; then return 1; fi

    local log_file="$LOG_DIR/es-sync-test-${date}.log"
    echo "[$(date '+%F %T')] ES测试模式已提交到后台运行"
    echo "  输入日期: $date"
    echo "  日志文件: $log_file"
    nohup java -cp "$JAR_FILE" "$MAIN_CLASS" --date "$date" --test > /dev/null 2>&1 &
    echo "  PID: $!"
}

# 补时间段数据（后台运行，完成后自动退出）
range() {
    if ! check_jar; then return 1; fi
    local start_date="$1"
    local end_date="$2"

    if [ -z "$start_date" ] || [ -z "$end_date" ]; then
        echo "用法: $0 range <开始日期> <结束日期>"
        echo "示例: $0 range 2026-05-10 2026-05-15"
        return 1
    fi
    if ! validate_date "$start_date" || ! validate_date "$end_date"; then return 1; fi

    local log_file="$LOG_DIR/es-sync-backfill-${start_date}-${end_date}.log"
    echo "[$(date '+%F %T')] ES时间段补数据已提交到后台运行"
    echo "  输入范围: $start_date ~ $end_date（实际各减一天）"
    echo "  日志文件: $log_file"
    nohup java -cp "$JAR_FILE" "$MAIN_CLASS" --start "$start_date" --end "$end_date" > /dev/null 2>&1 &
    echo "  PID: $!"
}

# ==================== 入口 ====================

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 2
        start
        ;;
    status)
        status
        ;;
    logs)
        logs
        ;;

    backfill)
        backfill "$2"
        ;;
    test)
        test_mode "$2"
        ;;
    range)
        range "$2" "$3"
        ;;

    *)
        echo "用法: $0 {start|stop|restart|status|logs|backfill|test|range} [参数...]"
        echo ""
        echo "  ES守护进程管理:"
        echo "    start                          启动ES定时守护进程（后台运行）"
        echo "    stop                           停止ES守护进程"
        echo "    restart                        重启ES守护进程"
        echo "    status                         查看运行状态"
        echo "    logs                           实时查看日志"
        echo ""
        echo "  ES手动补数据（后台运行，完成后自动退出）:"
        echo "    backfill <日期>                 补单天数据"
        echo "    test <日期>                     测试模式（日志输出前20条）"
        echo "    range <开始> <结束>             补时间段数据"
        echo ""
        echo "  日期格式: yyyy-MM-dd，传入日期会自动减一天（传入05-15查05-14）"
        echo ""
        echo "  示例:"
        echo "    $0 start"
        echo "    $0 backfill 2026-05-15"
        echo "    $0 test 2026-05-15"
        echo "    $0 range 2026-05-10 2026-05-15"
        exit 1
        ;;
esac
