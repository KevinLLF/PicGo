CREATE TABLE IF NOT EXISTS ${DWD_DB}.dwd_voc_data_info (
    item_id              STRING   COMMENT 'item_id',
    org_id               STRING   COMMENT '原始id',
    mid                  STRING   COMMENT 'id',
    title                STRING   COMMENT '标题',
    content              STRING   COMMENT '正文',
    ctime                BIGINT   COMMENT '创建时间',
    utime                BIGINT   COMMENT '修改时间',
    author_uid           STRING   COMMENT '作者id',
    author_name          STRING   COMMENT '作者姓名',
    author_mobile        STRING   COMMENT '作者手机号',
    author_province      STRING   COMMENT '作者省份',
    author_city          STRING   COMMENT '作者城市',
    like_count           BIGINT   COMMENT '点赞数',
    reply_count          BIGINT   COMMENT '评论数',
    repost_count         BIGINT   COMMENT '转发数',
    view_count           BIGINT   COMMENT '浏览数',
    share_count          BIGINT   COMMENT '分享/收藏数',
    site_name            STRING   COMMENT '来源平台名',
    voc_data_category    STRING   COMMENT '数据分类',
    voc_source_scope     STRING   COMMENT '数据公私域来源',
    wtype                BIGINT   COMMENT '文章发表类型'
)
COMMENT 'VOC数据明细宽表'
PARTITIONED BY (
    dt              STRING  COMMENT '数据日期分区, 格式yyyy-MM-dd',
    source_channel  STRING  COMMENT '来源渠道, 对应ODS源表名'
)
STORED AS PARQUET;


INSERT INTO TABLE ${DWD_DB}.dwd_voc_data_info
PARTITION (dt, source_channel)
SELECT
    md5(concat('ods_aionapp_article', id))                                       AS item_id,
    concat('ods_aionapp_article', id)                                           AS org_id,
    md5(concat('ods_aionapp_article', id))                                      AS mid,
    title                                                                       AS title,
    description                                                                 AS content,
    unix_timestamp(publish_time) * 1000                                         AS ctime,
    unix_timestamp(update_time) * 1000                                          AS utime,
    cast(publisher as string)                                                   AS author_uid,
    NULL                                                                        AS author_name,
    publisher_mobile                                                            AS author_mobile,
    province                                                                    AS author_province,
    city                                                                        AS author_city,
    0                                                                           AS like_count,
    0                                                                           AS reply_count,
    0                                                                           AS repost_count,
    basic_views                                                                 AS view_count,
    0                                                                           AS share_count,
    '埃安APP'                                                                    AS site_name,
    'review'                                                                    AS voc_data_category,
    'private'                                                                   AS voc_source_scope,
    1                                                                           AS wtype,
    '${azkaban.flow.1.days.ago}'                                                  AS dt,
    'ods_aionapp_article'                                                       AS source_channel
FROM ${SRC_ODS_DB}.ods_aionapp_article
WHERE to_date(publish_time) = '${azkaban.flow.1.days.ago}'
    AND id IS NOT NULL
    AND description IS NOT NULL

UNION ALL

SELECT
    md5(concat('ods_aionapp_cms_comment', id))                                  AS item_id,
    concat('ods_aionapp_cms_comment', id)                                      AS org_id,
    md5(concat('ods_aionapp_cms_comment', id))                                 AS mid,
    NULL                                                                        AS title,
    content                                                                     AS content,
    unix_timestamp(create_time) * 1000                                          AS ctime,
    unix_timestamp(update_time) * 1000                                          AS utime,
    cast(user_id as string)                                                     AS author_uid,
    nick_name                                                                   AS author_name,
    mobile                                                                      AS author_mobile,
    NULL                                                                        AS author_province,
    NULL                                                                        AS author_city,
    actual_liked_count                                                          AS like_count,
    0                                                                           AS reply_count,
    0                                                                           AS repost_count,
    0                                                                           AS view_count,
    0                                                                           AS share_count,
    '埃安APP'                                                                    AS site_name,
    'review'                                                                    AS voc_data_category,
    'private'                                                                   AS voc_source_scope,
    3                                                                           AS wtype,
    '${azkaban.flow.1.days.ago}'                                                  AS dt,
    'ods_aionapp_cms_comment'                                                   AS source_channel
FROM ${SRC_ODS_DB}.ods_aionapp_cms_comment
WHERE to_date(create_time) = '${azkaban.flow.1.days.ago}'
    AND id IS NOT NULL
    AND content IS NOT NULL

UNION ALL

