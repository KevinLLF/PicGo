SELECT
    md5(concat('ods_trumpchi_community_post', post_id))                          AS item_id,
    concat('ods_trumpchi_community_post', post_id)                              AS org_id,
    md5(concat('ods_trumpchi_community_post', post_id))                         AS mid,
    post_title                                                                  AS title,
    content                                                                     AS content,
    unix_timestamp(published_time) * 1000                                       AS ctime,
    unix_timestamp(updated_time) * 1000                                         AS utime,
    cast(user_id as string)                                                     AS author_uid,
    NULL                                                                        AS author_name,
    NULL                                                                        AS author_mobile,
    NULL                                                                        AS author_province,
    NULL                                                                        AS author_city,
    post_praise_count                                                           AS like_count,
    post_reply_count                                                            AS reply_count,
    post_forward_count                                                          AS repost_count,
    post_show_count                                                             AS view_count,
    post_share_count                                                            AS share_count,
    '传祺社区'                                                                   AS site_name,
    'review'                                                                    AS voc_data_category,
    'private'                                                                   AS voc_source_scope,
