    md5(concat('ods_trumpchi_mix_oa_order', number))                           AS mid,
    theme                                                                       AS title,
    call_content_process_require                                                AS content,
    unix_timestamp(issue_time) * 1000                                           AS ctime,
    unix_timestamp(issue_time) * 1000                                           AS utime,
    cast(customer_number as string)                                             AS author_uid,
    customer_name                                                               AS author_name,
    contact_phone                                                               AS author_mobile,
    province                                                                    AS author_province,
    city                                                                        AS author_city,
    0                                                                           AS like_count,
    0                                                                           AS reply_count,
    0                                                                           AS repost_count,
    0                                                                           AS view_count,
    0                                                                           AS share_count,
    '传祺工单'                                                                   AS site_name,
    'complaint'                                                                 AS voc_data_category,
    'private'                                                                   AS voc_source_scope,
    1                                                                           AS wtype,
    '${azkaban.flow.1.days.ago}'                                                  AS dt,
    'ods_trumpchi_mix_oa_order'                                                 AS source_channel
FROM ${SRC_ODS_DB}.ods_trumpchi_mix_oa_order
WHERE to_date(issue_time) = '${azkaban.flow.1.days.ago}'
    AND number IS NOT NULL
    AND call_content_process_require IS NOT NULL

UNION ALL

SELECT
    md5(concat('ods_aion_work_order', order_no))                                AS item_id,
    concat('ods_aion_work_order', order_no)                                    AS org_id,
    md5(concat('ods_aion_work_order', order_no))                               AS mid,
    title                                                                       AS title,
    content                                                                     AS content,
    unix_timestamp(create_time) * 1000                                          AS ctime,
    unix_timestamp(update_time) * 1000                                          AS utime,
    cast(client_id as string)                                                   AS author_uid,
    client_name                                                                 AS author_name,
    client_mobile                                                               AS author_mobile,
    NULL                                                                        AS author_province,
    NULL                                                                        AS author_city,
    0                                                                           AS like_count,
    0                                                                           AS reply_count,
    0                                                                           AS repost_count,
    0                                                                           AS view_count,
    0                                                                           AS share_count,
    '埃安工单'                                                                   AS site_name,
    'complaint'                                                                 AS voc_data_category,
    'private'                                                                   AS voc_source_scope,
    1                                                                           AS wtype,
    '${azkaban.flow.1.days.ago}'                                                  AS dt,
    'ods_aion_work_order'                                                       AS source_channel
FROM ${SRC_ODS_DB}.ods_aion_work_order
WHERE to_date(create_time) = '${azkaban.flow.1.days.ago}'
    AND order_no IS NOT NULL
    AND content IS NOT NULL
;
