    concat('ods_trumpchi_channel_question', question_id)                        AS org_id,
    md5(concat('ods_trumpchi_channel_question', question_id))                   AS mid,
    NULL                                                                        AS title,
    question_content                                                            AS content,
    unix_timestamp(create_time) * 1000                                          AS ctime,
    unix_timestamp(update_time) * 1000                                          AS utime,
    cast(user_id as string)                                                    	AS author_uid,
    NULL                                                                        AS author_name,
    NULL                                                                        AS author_mobile,
    NULL                                                                        AS author_province,
    NULL                                                                        AS author_city,
    0                                                                           AS like_count,
    0                                                                           AS reply_count,
    0                                                                           AS repost_count,
    browse_count                                                                AS view_count,
    0                                                                           AS share_count,
    '传祺渠道提问'                                                               AS site_name,
    'review'                                                                    AS voc_data_category,
